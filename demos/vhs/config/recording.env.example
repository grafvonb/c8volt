# Optional: select an existing c8volt config and profile before recording.
# Otherwise normal config discovery and its active profile apply.
# The effective configuration and the target must both use Camunda 8.10.
# Authentication (none, cookie, OAuth2) stays in your normal c8volt setup.

export C8VOLT_CONFIG="$HOME/.config/c8volt/config.yaml"
export C8VOLT_ACTIVE_PROFILE="c810"

